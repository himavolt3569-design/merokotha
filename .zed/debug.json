// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
  {
    "label": "Flutter (Debug)",
    "adapter": "flutter",
    "request": "launch",
    "program": "lib/main.dart",
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Flutter (Profile)",
    "adapter": "flutter",
    "request": "launch",
    "program": "lib/main.dart",
    "args": ["--profile"],
    "cwd": "$ZED_WORKTREE_ROOT",
  },
  {
    "label": "Flutter (Release)",
    "adapter": "flutter",
    "request": "launch",
    "program": "lib/main.dart",
    "args": ["--release"],
    "cwd": "$ZED_WORKTREE_ROOT",
  },
]
